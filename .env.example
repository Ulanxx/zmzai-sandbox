# Server-side URLs. The browser never receives Relay credentials.
AUTH_URL=https://auth.zmzai.cloud
RELAY_URL=https://m.zmzai.cloud/api/v1
# 私网 Relay 地址；生产环境必须设置服务密钥。开发环境可暂时指向 Relay 公网地址。
RELAY_INTERNAL_URL=http://127.0.0.1:3002
RELAY_SANDBOX_SERVICE_SECRET_CURRENT=replace-with-shared-server-side-secret
OPEN_SANDBOX_URL=http://127.0.0.1:8080
OPEN_SANDBOX_API_KEY=replace-with-server-side-key
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_IMAGE=node:22-alpine
OPEN_SANDBOX_CPU_LIMIT=500m
OPEN_SANDBOX_MEMORY_LIMIT=512Mi
